<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Email OTP Verification</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      color: #333;
      margin: 0;
      padding: 0;
      background-color: #f7f9fc;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .header {
      text-align: center;
      padding: 20px 0;
      background-color: #f96d08;
      box-sizing: border-box;
      color: #f7f9fc;
    }

    .header h2 {
      color: #fff;
      font-size: 24px;
      margin: 0 0 10px;
    }

    .content {
      text-align: center;
      padding: 20px;
    }

    .content h1 {
      color: #110f0f;
      font-size: 24px;
      margin: 0 0 10px;
    }

    .otp-code {
      font-size: 36px;
      font-weight: bold;
      color: #ce089d;
      letter-spacing: 2px;
      margin: 20px 0;
    }

    .instructions {
      font-size: 16px;
      color: #666;
      line-height: 1.6;
    }

    .footer {
      text-align: center;
      padding: 20px;
      font-size: 14px;
      color: #999;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="header">
      {{!-- <img src="{{logo_url}}" alt="Company Logo"> --}}
      <h2>Welcome to the BackendEngineeringCore</h2>
    </div>
    <div class="content">
      <h1>Email Verification</h1>
      <p class="instructions">Use the OTP code below to verify your email address. This code will expire in 10 minutes.
      </p>
      <p class="otp-code">{{otp}}</p>
      <p class="instructions">If you didn’t request this, please ignore this email.</p>
    </div>
    <div class="footer">
      &copy; {{year}} Company Name. All rights reserved.
    </div>
  </div>
</body>

</html>